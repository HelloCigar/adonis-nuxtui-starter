{
  "name": "adonis-nuxtui-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "oxlint && eslint --cache --cache-location node_modules/.cache/eslint/ && tidy check",
    "format": "tidy up",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-ast-grep": "^1.0.0",
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisplus/flow": "^1.1.0",
    "@iconify-json/lucide": "^1.2.159",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "hot-hook": "^1.1.0",
    "oxlint": "^1.95.0",
    "oxlint-plugin-vize": "^0.799.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.1",
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/cors": "^3.0.1",
    "@adonisjs/inertia": "^5.0.6",
    "@adonisjs/lucid": "^22.5.0",
    "@adonisjs/session": "^8.4.0",
    "@adonisjs/shield": "^9.0.1",
    "@adonisjs/static": "^2.0.2",
    "@adonisjs/vite": "^6.0.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/vue3": "^3.11.0",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.13.1",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/table-core": "^8.21.3",
    "@tuyau/core": "^1.3.1",
    "@vinejs/vine": "^4.4.0",
    "@vue/server-renderer": "^3.5.46",
    "@vueuse/core": "^15.1.0",
    "better-sqlite3": "^13.2.0",
    "date-fns": "^4.4.0",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
