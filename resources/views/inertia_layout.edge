<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title data-inertia>
      AdonisJS
    </title>

    <style>
      html { background-color: #ffffff }
      html.dark { background-color: #111111 }
    </style>
    {{-- Apply the stored color mode before first paint (same key as @vueuse/core useColorMode) --}}
    <script>
      (function () {
        var mode = localStorage.getItem('vueuse-color-scheme') || 'auto'
        var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        if (dark) {
          document.documentElement.classList.add('dark')
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#111111')
        }
      })()
    </script>

    @vite(['inertia/app.ts'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia({ class: 'isolate' })
  </body>

</html>
